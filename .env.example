PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

GROQ_API_KEY=
# Optional extras (comma-separated) — used when the primary key hits TPM/RPM limits
GROQ_API_KEYS=
GEMINI_API_KEY=
OPENAI_API_KEY=

# LangSmith — traces LangChain / LangGraph LLM calls (optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=HobbyFlow

PLAN_CACHE_TTL_MS=86400000

# Supabase — secret/service role key stays server-side only
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Tavily — web search for resource grounding (server-side only; used in later roadmap content specs)
TAVILY_API_KEY=

# Lesson media resolve (spec 17) — optional; curated/SVG fallbacks used when empty
YOUTUBE_API_KEY=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Optional test account for API docs (create in Supabase Auth if needed)
# TEST_USER_EMAIL=omesh@gmail.com
# TEST_USER_PASSWORD=test@123

# Written automatically by 2_start.sh on deploy (do not set manually in CI PROD_ENV)
# DEPLOY_GIT_SHA=
# DEPLOY_GIT_SHORT=
# DEPLOYED_AT=
